            "url": "https://github.com/Brahmworks"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Brahmworks/BrahmWiki.git"
    },
    "license": "MIT",
    "frameworks": "arduino, espidf",
    "platforms": "espressif32, atmelavr, atmelsam",
    "headers": "include/*.h",
    "src_dir": "include",
    "examples": [
        "examples/esp32_host/README.md",
        "examples/atmega_client/README.md",
        "examples/pingpong/README.md"
